        <di:waypoint x="700" y="818"/>
        <di:waypoint x="601" y="818"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
