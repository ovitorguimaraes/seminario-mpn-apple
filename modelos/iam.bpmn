        <di:waypoint x="1476" y="725"/>
        <di:waypoint x="1548" y="725"/>
        <di:waypoint x="1548" y="791"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="iam_f21_di" bpmnElement="iam_f21">
        <di:waypoint x="1530" y="809"/>
