        <bpmndi:BPMNLabel>
          <dc:Bounds x="890" y="233" width="150" height="30"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="iam_f8_di" bpmnElement="iam_f8">
        <di:waypoint x="1150" y="260"/>
        <di:waypoint x="1220" y="260"/>
      </bpmndi:BPMNEdge>
