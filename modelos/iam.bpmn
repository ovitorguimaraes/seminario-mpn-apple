          <dc:Bounds x="1175" y="751" width="180" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="iam_signal_di" bpmnElement="iam_signal">
        <dc:Bounds x="1530" y="791" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1465" y="835" width="180" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="iam_recert_di" bpmnElement="iam_recert">
        <dc:Bounds x="1020" y="693" width="150" height="64"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="iam_keep_di" bpmnElement="iam_keep">
        <dc:Bounds x="894" y="699" width="52" height="52"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="829" y="664" width="180" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="iam_revoke_di" bpmnElement="iam_revoke">
        <dc:Bounds x="700" y="786" width="150" height="64"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="iam_closed_di" bpmnElement="iam_closed">
