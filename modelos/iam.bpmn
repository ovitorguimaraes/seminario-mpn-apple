        <dc:Bounds x="200" y="87" width="150" height="64"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="iam_complete_di" bpmnElement="iam_complete">
        <dc:Bounds x="424" y="93" width="52" height="52"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="359" y="58" width="180" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
