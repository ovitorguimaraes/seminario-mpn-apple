<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="iam_defs" targetNamespace="https://seminario.local/bpmn" exporter="Seminário SI" exporterVersion="1">
  <bpmn:signal id="iam_change_signal" name="Mudança de função ou desligamento"/>
  <bpmn:process id="iam_process" name="Gestão de acessos ao desenvolvimento" isExecutable="false">
    <bpmn:documentation>Proposta acadêmica de processo interno aplicada ao contexto da Apple. Responsáveis, critérios e sistemas são definidos pelo grupo, sem validação da Apple.</bpmn:documentation>
    <bpmn:laneSet id="iam_lanes">
      <bpmn:lane id="iam_lane0" name="Solicitante">
        <bpmn:flowNodeRef>iam_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>iam_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>iam_complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>iam_adjust</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="iam_lane1" name="Gestor">
        <bpmn:flowNodeRef>iam_manager</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>iam_approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>iam_deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>iam_denied</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="iam_lane2" name="Segurança da informação">
        <bpmn:flowNodeRef>iam_policy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>iam_valid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="iam_lane3" name="Administração de sistemas">
        <bpmn:flowNodeRef>iam_grant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>iam_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>iam_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>iam_timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>iam_signal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>iam_recert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>iam_keep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>iam_revoke</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>iam_closed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="iam_start" name="Necessidade de acesso">
      <bpmn:outgoing>iam_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="iam_request" name="Informar perfil sistema e motivo">
      <bpmn:incoming>iam_f1</bpmn:incoming>
      <bpmn:incoming>iam_f4</bpmn:incoming>
    <bpmn:outgoing>iam_f2</bpmn:outgoing>
      </bpmn:task>
    <bpmn:exclusiveGateway id="iam_complete" name="Pedido completo?">
      <bpmn:incoming>iam_f2</bpmn:incoming>
      <bpmn:outgoing>iam_f3</bpmn:outgoing>
      <bpmn:outgoing>iam_f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="iam_adjust" name="Complementar solicitação">
      <bpmn:incoming>iam_f3</bpmn:incoming>
      <bpmn:outgoing>iam_f4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="iam_manager" name="Avaliar necessidade e vínculo funcional">
      <bpmn:incoming>iam_f5</bpmn:incoming>
      <bpmn:outgoing>iam_f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="iam_approve" name="Gestor aprova?">
      <bpmn:incoming>iam_f6</bpmn:incoming>
      <bpmn:outgoing>iam_f7</bpmn:outgoing>
      <bpmn:outgoing>iam_f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="iam_deny" name="Registrar motivo e comunicar recusa">
      <bpmn:incoming>iam_f7</bpmn:incoming>
      <bpmn:incoming>iam_f11</bpmn:incoming>
    <bpmn:outgoing>iam_f8</bpmn:outgoing>
      </bpmn:task>
    <bpmn:endEvent id="iam_denied" name="Pedido recusado">
      <bpmn:incoming>iam_f8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="iam_policy" name="Checar privilégios e conflitos">
      <bpmn:incoming>iam_f9</bpmn:incoming>
      <bpmn:outgoing>iam_f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="iam_valid" name="Perfil conforme a política?">
      <bpmn:incoming>iam_f10</bpmn:incoming>
      <bpmn:outgoing>iam_f11</bpmn:outgoing>
      <bpmn:outgoing>iam_f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="iam_grant" name="Configurar acesso, MFA e validade">
      <bpmn:incoming>iam_f12</bpmn:incoming>
      <bpmn:outgoing>iam_f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="iam_audit" name="Validar e registrar a concessão">
      <bpmn:incoming>iam_f13</bpmn:incoming>
      <bpmn:outgoing>iam_f14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:eventBasedGateway id="iam_wait" name="Aguardar evento">
      <bpmn:incoming>iam_f14</bpmn:incoming>
      <bpmn:incoming>iam_f18</bpmn:incoming>
      <bpmn:outgoing>iam_f15</bpmn:outgoing>
      <bpmn:outgoing>iam_f20</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="iam_timer" name="Revisão em 90 dias">
      <bpmn:incoming>iam_f15</bpmn:incoming>
      <bpmn:outgoing>iam_f16</bpmn:outgoing>
      <bpmn:timerEventDefinition id="iam_timer_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P90D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="iam_signal" name="Mudança / saída">
      <bpmn:incoming>iam_f20</bpmn:incoming>
      <bpmn:outgoing>iam_f21</bpmn:outgoing>
      <bpmn:signalEventDefinition id="iam_signal_def" signalRef="iam_change_signal"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="iam_recert" name="Reavaliar vínculo e necessidade">
      <bpmn:incoming>iam_f16</bpmn:incoming>
      <bpmn:outgoing>iam_f17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="iam_keep" name="Acesso ainda necessário?">
      <bpmn:incoming>iam_f17</bpmn:incoming>
      <bpmn:outgoing>iam_f18</bpmn:outgoing>
      <bpmn:outgoing>iam_f19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="iam_revoke" name="Revogar acessos e registrar">
      <bpmn:incoming>iam_f19</bpmn:incoming>
      <bpmn:incoming>iam_f21</bpmn:incoming>
      <bpmn:outgoing>iam_f22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="iam_closed" name="Acesso encerrado">
      <bpmn:incoming>iam_f22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="iam_f1" sourceRef="iam_start" targetRef="iam_request" name=""/>
    <bpmn:sequenceFlow id="iam_f2" sourceRef="iam_request" targetRef="iam_complete" name=""/>
    <bpmn:sequenceFlow id="iam_f3" sourceRef="iam_complete" targetRef="iam_adjust" name="Não"/>
    <bpmn:sequenceFlow id="iam_f4" sourceRef="iam_adjust" targetRef="iam_request" name=""/>
    <bpmn:sequenceFlow id="iam_f5" sourceRef="iam_complete" targetRef="iam_manager" name="Sim"/>
    <bpmn:sequenceFlow id="iam_f6" sourceRef="iam_manager" targetRef="iam_approve" name=""/>
    <bpmn:sequenceFlow id="iam_f7" sourceRef="iam_approve" targetRef="iam_deny" name="Não"/>
    <bpmn:sequenceFlow id="iam_f8" sourceRef="iam_deny" targetRef="iam_denied" name=""/>
    <bpmn:sequenceFlow id="iam_f9" sourceRef="iam_approve" targetRef="iam_policy" name="Sim"/>
    <bpmn:sequenceFlow id="iam_f10" sourceRef="iam_policy" targetRef="iam_valid" name=""/>
    <bpmn:sequenceFlow id="iam_f11" sourceRef="iam_valid" targetRef="iam_deny" name="Não"/>
    <bpmn:sequenceFlow id="iam_f12" sourceRef="iam_valid" targetRef="iam_grant" name="Sim"/>
    <bpmn:sequenceFlow id="iam_f13" sourceRef="iam_grant" targetRef="iam_audit" name=""/>
    <bpmn:sequenceFlow id="iam_f14" sourceRef="iam_audit" targetRef="iam_wait" name=""/>
    <bpmn:sequenceFlow id="iam_f15" sourceRef="iam_wait" targetRef="iam_timer" name=""/>
    <bpmn:sequenceFlow id="iam_f16" sourceRef="iam_timer" targetRef="iam_recert" name=""/>
    <bpmn:sequenceFlow id="iam_f17" sourceRef="iam_recert" targetRef="iam_keep" name=""/>
    <bpmn:sequenceFlow id="iam_f18" sourceRef="iam_keep" targetRef="iam_wait" name="Sim: renovar validade"/>
    <bpmn:sequenceFlow id="iam_f19" sourceRef="iam_keep" targetRef="iam_revoke" name="Não"/>
    <bpmn:sequenceFlow id="iam_f20" sourceRef="iam_wait" targetRef="iam_signal" name=""/>
    <bpmn:sequenceFlow id="iam_f21" sourceRef="iam_signal" targetRef="iam_revoke" name=""/>
    <bpmn:sequenceFlow id="iam_f22" sourceRef="iam_revoke" targetRef="iam_closed" name=""/>
  </bpmn:process>
  <bpmn:collaboration id="iam_collab">
    <bpmn:participant id="iam_pool" name="Gestão de acessos ao desenvolvimento" processRef="iam_process"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="iam_diagram">
    <bpmndi:BPMNPlane id="iam_plane" bpmnElement="iam_collab">
      <bpmndi:BPMNShape id="iam_pool_di" bpmnElement="iam_pool" isHorizontal="true">
        <dc:Bounds x="1" y="25" width="1658" height="840"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="iam_lane0_di" bpmnElement="iam_lane0" isHorizontal="true">
        <dc:Bounds x="52" y="25" width="1607" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="iam_lane1_di" bpmnElement="iam_lane1" isHorizontal="true">
        <dc:Bounds x="52" y="185" width="1607" height="155"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="iam_lane2_di" bpmnElement="iam_lane2" isHorizontal="true">
        <dc:Bounds x="52" y="340" width="1607" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="iam_lane3_di" bpmnElement="iam_lane3" isHorizontal="true">
        <dc:Bounds x="52" y="500" width="1607" height="365"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="iam_start_di" bpmnElement="iam_start">
        <dc:Bounds x="115" y="101" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="50" y="145" width="180" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
